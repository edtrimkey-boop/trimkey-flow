# Supabase — Public (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — Server only (NEVER expose via NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=

# Trim Key Flow — Server only
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FLOW_ENCRYPTION_KEY=

# Base URL of this deployment
FLOW_API_BASE_URL=https://flow.trimkey.in

# Razorpay — Server only
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
